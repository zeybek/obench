package obench_tests

import obench "../obench"
import "core:testing"

// Expected values from a separate Python implementation of the same rules (Theil-Sen,
// Mann-Kendall with the variance raised for the autocorrelation of the detrended samples,
// and the kernel density peak count), run on these samples.
@(private = "file")
_Shape_Case :: struct {
	name:       string,
	samples:    []f64,
	change_pct: f64,
	z:          f64,
	modes:      int,
}

@(test)
test_sample_trend_and_modes_match_a_reference :: proc(t: ^testing.T) {
	cases := []_Shape_Case {
		{
			name = "flat",
			samples = []f64 {
				98.7214,
				99.3951,
				100.3294,
