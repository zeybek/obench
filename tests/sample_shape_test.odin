	for c in cases {
		change, z := obench.sample_trend(c.samples)
		testing.expectf(
			t,
			abs(change - c.change_pct) < 1e-9,
			"%s: change %v, want %v",
			c.name,
			change,
			c.change_pct,
		)
		testing.expectf(t, abs(z - c.z) < 1e-9, "%s: z %v, want %v", c.name, z, c.z)
		testing.expectf(
			t,
			obench.count_modes(c.samples) == c.modes,
			"%s: modes %d, want %d",
			c.name,
			obench.count_modes(c.samples),
			c.modes,
		)
	}
}

@(test)
test_effective_sample_count :: proc(t: ^testing.T) {
	testing.expect_value(t, obench.effective_sample_count(50, 0), 50.0)
	testing.expect_value(t, obench.effective_sample_count(50, -0.3), 50.0)
	testing.expect(t, abs(obench.effective_sample_count(50, 0.4) - 50.0 * 0.6 / 1.4) < 1e-12)
	testing.expect_value(t, obench.effective_sample_count(50, 0.99), 2.0)
}
