			change_pct = 0.6726564820934635,
			z = 0.4911004591903261,
			modes = 2,
		},
		{
			name = "skewed",
			samples = []f64 {
				93.4212,
				104.136,
				105.9901,
				83.6138,
				81.2631,
				105.4584,
				100.31,
				103.304,
				112.7229,
				106.665,
				92.9003,
