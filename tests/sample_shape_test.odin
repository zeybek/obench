				105.5611,
				104.7115,
				104.7149,
				104.5121,
				105.4219,
				105.8092,
				105.8447,
				105.3511,
				105.7176,
				105.8907,
				106.7216,
				106.4118,
				106.9831,
				108.1117,
				106.5052,
				107.4988,
				107.8116,
				107.2805,
				108.7429,
				108.2928,
				108.8105,
				109.112,
				109.7242,
				108.9043,
				109.1152,
				108.9968,
				109.2075,
			},
			change_pct = 9.116285096963757,
			z = 9.535937855668525,
			modes = 1,
		},
		{
			name = "bimodal",
			samples = []f64 {
				132.766,
				99.4019,
				97.4999,
				131.1012,
				102.6979,
